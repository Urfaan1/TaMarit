generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Article {
  id              Int      @id @default(autoincrement())
  category        String
  title           String
  author          String?
  period          String?
  summary         String
  fullContent     String
  badgeText       String
  badgeVariant    String
  keyTerm         String?
  keyTermMeaning  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VisitorCount {
  id    Int @id @default(autoincrement())
  count Int @default(0)
}
